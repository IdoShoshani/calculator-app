# Default: normalize line endings to LF in the repo
* text=auto eol=lf

# Windows batch scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must be LF (or they break on Linux/macOS)
*.sh text eol=lf
mvnw text eol=lf

# Binaries — no line-ending conversion
*.jar binary
*.png binary
*.jpg binary
