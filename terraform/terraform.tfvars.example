# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored — never commit real values.

aws_region    = "us-east-1"
instance_type = "t2.micro"        # free-tier eligible
app_port      = 8080
ssh_key_name  = "my-key-pair"     # name of an existing EC2 key pair
docker_image  = "yourdockerhubuser/calculator-app:latest"

# Your public IP only — run: curl -s ifconfig.me
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"
